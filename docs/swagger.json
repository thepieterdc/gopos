{
    "swagger": "2.0",
    "info": {
        "description": "Address and place information service.",
        "title": "Gopos",
        "contact": {}
    },
    "basePath": "/",
    "paths": {
        "/address/normalise": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "Normalise an address into its possible expansions.",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Address to normalise.",
                        "name": "query",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/address.normaliseResponse"
                        }
                    },
                    "400": {
                        "description": "Missing or invalid query parameters."
                    }
                }
            }
        },
        "/address/resolve": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "Resolve an address query into structured address information.",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Address to resolve.",
                        "name": "query",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Country of the address, improves accuracy if known.",
                        "name": "country",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "libpostal",
                            "google"
                        ],
                        "type": "string",
                        "default": "libpostal",
                        "description": "Resolver to use.",
                        "name": "resolver",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/address.resolveResponse"
                        }
                    },
                    "400": {
                        "description": "Missing or invalid query parameters."
                    }
                }
            }
        },
        "/google/place/{id}": {
            "get": {
                "description": "Returns 503 when no Google Maps API key is configured.",
                "produces": [
                    "application/json"
                ],
                "summary": "Get the details of a Google Place ID.",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Google Place ID.",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/google.GooglePlaceDetails"
                        }
                    },
                    "400": {
                        "description": "Missing place ID."
                    },
                    "503": {
                        "description": "Google Maps API key is not configured."
                    }
                }
            }
        },
        "/health": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "Health check.",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/routes.healthResponse"
                        }
                    }
                }
            }
        },
        "/timezone": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "Look up the timezone of a coordinate pair.",
                "parameters": [
                    {
                        "type": "number",
                        "description": "Latitude.",
                        "name": "latitude",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "description": "Longitude.",
                        "name": "longitude",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/routes.timezoneResponse"
                        }
                    },
                    "400": {
                        "description": "Missing or invalid query parameters."
                    }
                }
            }
        }
    },
    "definitions": {
        "address.normaliseResponse": {
            "type": "object",
            "properties": {
                "normalised": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "query": {
                    "type": "string"
                }
            }
        },
        "address.resolveResponse": {
            "type": "object",
            "properties": {
                "address_info": {
                    "$ref": "#/definitions/location.AddressInfo"
                },
                "display_address": {
                    "type": "string"
                },
                "query": {
                    "type": "string"
                },
                "resolver": {
                    "type": "string"
                }
            }
        },
        "google.GoogleAddressComponent": {
            "type": "object",
            "properties": {
                "long_name": {
                    "type": "string"
                },
                "short_name": {
                    "type": "string"
                },
                "types": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "google.GoogleGeometry": {
            "type": "object",
            "properties": {
                "location": {
                    "$ref": "#/definitions/google.GoogleLocation"
                }
            }
        },
        "google.GoogleLocation": {
            "type": "object",
            "properties": {
                "lat": {
                    "type": "number"
                },
                "lng": {
                    "type": "number"
                }
            }
        },
        "google.GooglePlaceDetails": {
            "type": "object",
            "properties": {
                "address_components": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/google.GoogleAddressComponent"
                    }
                },
                "business_status": {
                    "type": "string"
                },
                "formatted_address": {
                    "type": "string"
                },
                "geometry": {
                    "$ref": "#/definitions/google.GoogleGeometry"
                },
                "icon": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "place_id": {
                    "type": "string"
                },
                "plus_code": {
                    "$ref": "#/definitions/google.GooglePlusCode"
                },
                "types": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "url": {
                    "type": "string"
                },
                "utc_offset": {
                    "type": "integer"
                },
                "vicinity": {
                    "type": "string"
                }
            }
        },
        "google.GooglePlusCode": {
            "type": "object",
            "properties": {
                "compound_code": {
                    "type": "string"
                },
                "global_code": {
                    "type": "string"
                }
            }
        },
        "location.AddressInfo": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string"
                },
                "country": {
                    "type": "string"
                },
                "postal_code": {
                    "type": "string"
                },
                "state_or_province": {
                    "type": "string"
                },
                "street": {
                    "type": "string"
                },
                "street_number": {
                    "type": "string"
                },
                "unit": {
                    "type": "string"
                }
            }
        },
        "routes.healthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "boolean"
                },
                "version": {
                    "type": "string"
                }
            }
        },
        "routes.timezoneResponse": {
            "type": "object",
            "properties": {
                "latitude": {
                    "type": "number"
                },
                "longitude": {
                    "type": "number"
                },
                "timezone": {
                    "type": "string"
                }
            }
        }
    }
}